# Supabase Dashboard > Connect > Transaction pooler (port 6543)
DATABASE_URL=postgresql://postgres.PROJECT_REF:DB_PASSWORD@REGION.pooler.supabase.com:6543/postgres

# Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=replace-with-server-only-sb-secret-key

# Must match the private bucket created by the migration.
SUPABASE_STORAGE_BUCKET=swing-media

# Server-only Gemini credential. Never expose this value to the browser.
GEMINI_API_KEY=replace-with-server-only-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash

# Custom GPT Action > Authentication > API key > Bearer.
GPT_ACTION_API_KEY=replace-with-a-long-random-server-only-key
INTERNAL_API_TOKEN=replace-with-a-different-long-random-server-only-key

# Only temporary file hosts issued by ChatGPT may be downloaded.
GPT_ACTION_FILE_HOSTS=["files.oaiusercontent.com"]

# Local Vite prototype origins accepted by FastAPI.
CORS_ORIGINS=["http://localhost:4173","http://127.0.0.1:4173"]

# Optional until the product upload limit is approved. Value is bytes.
# MAX_VIDEO_BYTES=104857600
